import numpy as np

# Make random numbers come out same each time so changes come from code changes, not random number changes
np.random.seed(1)

# Parameters (from the symbol table)
f, sigma, phi0, eta, phi_bar, a = 0.015, 0.20, 0.065, 0.06, 0.03, 1
omega = 1 / sigma**2      # 25
gamma = 1 / eta**2        # ~277

# One fund, one year
t = 1
phi_old = phi0
R = 0.20                                           # set by hand for testing
r = (2 * f / phi_old) * (R - phi_old)              # investor return
phi_new = ((gamma + (t - 1) * omega) * phi_old + omega * R) / (gamma + t * omega)  # Block 5
q_new = phi_new**2 / (4 * a * f)                   # fund size
print(r, phi_new, q_new)